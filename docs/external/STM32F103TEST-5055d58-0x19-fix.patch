+static uds_responseCode_t NumberOfEmissionsOBDDTCByStatusMask (const uint8_t * receiveBuffer, uint32_t receiveBufferSize)
+{
+    static uint8_t s_buffer[6U];
+    DTC_t *dtcs;
+    DTC_header_t *header;
+    uint16_t count = 0U;
+    uint8_t statusMask;
+
+    if (receiveBuffer == NULL || receiveBufferSize != 3U)
+    {
+        charon_sendNegativeResponse(
+            uds_responseCode_IncorrectMessageLengthOrInvalidFormat,
+            uds_sid_ReadDtcInformation);
+        return uds_responseCode_IncorrectMessageLengthOrInvalidFormat;
+    }
+
+    statusMask = receiveBuffer[2];
+    dtcs = (DTC_t*)charon_NvmDriver_getNvmAddress_for_DTC(0, false);
+    header = (DTC_header_t*)charon_NvmDriver_getNvmAddress_for_DTC(0, true);
+
+    for (uint32_t i = 0U;
+         header != NULL && dtcs != NULL && i < header->totalDTCCounter &&
+         i < AMOUNT_OF_DTC; ++i)
+    {
+        if (!charon_DTC_LookupTable_entry_valid(i) ||
+            dtcs[i].FunctionalGroupIdentifier != 0x33U ||
+            (dtcs[i].DTCStatusMask & statusMask) == 0U) continue;
+        if (count != UINT16_MAX) ++count;
+    }
+
+    s_buffer[0] = (uds_sid_ReadDtcInformation | (uint8_t)uds_sid_PositiveResponseMask);
+    s_buffer[1] = reportNumberOfEmissionsOBDDTCByStatusMask;
+    s_buffer[2] = charon_getDTCStatusAvailabilityMask();
+    s_buffer[3] = DTC_Format_Identifier;
+    s_buffer[4] = (uint8_t)(count >> 8U);
+    s_buffer[5] = (uint8_t)count;
+    charon_sscTxMessage(s_buffer, sizeof(s_buffer));
+    return uds_responseCode_PositiveResponse;
+}
+
