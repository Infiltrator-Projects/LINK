+static uds_responseCode_t DTCWithPermanentStatus (const uint8_t * receiveBuffer, uint32_t receiveBufferSize)
+{
+    static uint8_t s_buffer[3U];
+    (void)receiveBuffer;
+
+    if (receiveBufferSize != 2U)
+    {
+        charon_sendNegativeResponse(
+            uds_responseCode_IncorrectMessageLengthOrInvalidFormat,
+            uds_sid_ReadDtcInformation);
+        return uds_responseCode_IncorrectMessageLengthOrInvalidFormat;
+    }
+
+    /*
+     * There is no separate permanent-DTC backing model here. Return an honest
+     * empty list instead of mislabelling confirmedDTC as permanentDTC.
+     */
+    s_buffer[0] = (uds_sid_ReadDtcInformation | (uint8_t)uds_sid_PositiveResponseMask);
+    s_buffer[1] = reportDTCWithPermanentStatus;
+    s_buffer[2] = charon_getDTCStatusAvailabilityMask();
+    charon_sscTxMessage(s_buffer, sizeof(s_buffer));
+    return uds_responseCode_PositiveResponse;
+}
