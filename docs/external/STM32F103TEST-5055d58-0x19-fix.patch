+static uds_responseCode_t DTCFaultDetectionCounter (const uint8_t * receiveBuffer, uint32_t receiveBufferSize)
+{
+    static uint8_t s_buffer[MAX_TX_BUFFER_SIZE];
+    DTC_t *dtcs;
+    DTC_header_t *header;
+    uint32_t length = 2U;
+
+    (void)receiveBuffer;
+    if (receiveBufferSize != 2U)
+    {
+        charon_sendNegativeResponse(
+            uds_responseCode_IncorrectMessageLengthOrInvalidFormat,
+            uds_sid_ReadDtcInformation);
+        return uds_responseCode_IncorrectMessageLengthOrInvalidFormat;
+    }
+
+    s_buffer[0] = (uds_sid_ReadDtcInformation | (uint8_t)uds_sid_PositiveResponseMask);
+    s_buffer[1] = reportDTCFaultDetectionCounter;
+    dtcs = (DTC_t*)charon_NvmDriver_getNvmAddress_for_DTC(0, false);
+    header = (DTC_header_t*)charon_NvmDriver_getNvmAddress_for_DTC(0, true);
+
+    for (uint32_t i = 0U;
+         header != NULL && dtcs != NULL && i < header->totalDTCCounter &&
+         i < AMOUNT_OF_DTC; ++i)
+    {
+        const int8_t counter = charon_getDTCFaultDetectionCounterByIndex(i);
+        if (!charon_DTC_LookupTable_entry_valid(i) ||
+            counter <= 0 || counter >= 127) continue;
+        if (length + 4U > MAX_TX_BUFFER_SIZE)
+        {
+            charon_sendNegativeResponse(
+                uds_responseCode_ResponseTooLong, uds_sid_ReadDtcInformation);
+            return uds_responseCode_ResponseTooLong;
+        }
+        s_buffer[length++] = dtcs[i].DTCHighByte;
+        s_buffer[length++] = dtcs[i].DTCMiddleByte;
+        s_buffer[length++] = dtcs[i].DTCLowByte;
+        s_buffer[length++] = (uint8_t)counter;
+    }
+
+    charon_sscTxMessage(s_buffer, length);
+    return uds_responseCode_PositiveResponse;
+}
